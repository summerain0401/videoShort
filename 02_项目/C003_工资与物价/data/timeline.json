    },
    {
      "sceneId": "S03",
      "start": 19.312,
      "end": 31.512,
      "backgroundName": "超市内部",
      "subtitle": {
        "text": "为什么会这样？因为物价是被大家一起抬上去的：原材料涨、人工贵、房租高，每一环成本都悄悄加进商品价格里，买单的还是你。",
        "start": 19.312,
        "end": 31.312,
        "highlights": [
          "成本",
          "商品价格"
        ]
      },
      "elements": [
        {
          "type": "character",
          "name": "小明",
          "emotion": "serious",
          "enterFrom": "none",
          "position": null,
          "zIndex": 2,
          "duration": [
            19.312,
            31.512
          ]
        },
        {
          "type": "prop",
          "name": "超市货架",
          "emotion": null,
          "enterFrom": "right",
          "position": null,
          "zIndex": 3,
          "duration": [
            19.312,
            31.512
