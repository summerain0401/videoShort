    {
      "sceneId": "S02",
      "start": 7.181,
      "end": 16.311,
      "backgroundName": "超市内部",
      "subtitle": {
        "text": "其实这不是错觉。工资涨的是数字，物价涨的是生活成本。物价跑得比工资快，你的购买力就在偷偷缩水。",
        "start": 7.181,
        "end": 16.111,
        "highlights": [
          "物价",
          "购买力"
        ]
      },
      "elements": [
        {
          "type": "character",
          "name": "小布丁",
          "emotion": "explaining",
          "enterFrom": "none",
          "position": null,
          "zIndex": 2,
