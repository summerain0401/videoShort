    {
      "sceneId": "S02",
      "start": 9.725,
      "end": 19.312,
      "backgroundName": "超市内部",
      "subtitle": {
        "text": "其实这不是错觉。工资涨的是数字，物价涨的是生活成本。物价跑得比工资快，你的购买力就在偷偷缩水。",
        "start": 9.725,
        "end": 19.113,
        "highlights": [
          "物价",
          "购买力"
        ]
      },
      "elements": [
        {
