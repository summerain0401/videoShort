          ]
        }
      ]
    },
    {
      "sceneId": "S03",
      "start": 16.311,
      "end": 27.926,
      "backgroundName": "超市内部",
      "subtitle": {
        "text": "为什么会这样？因为物价是被大家一起抬上去的：原材料涨、人工贵、房租高，每一环成本都悄悄加进商品价格里，买单的还是你。",
        "start": 16.311,
        "end": 27.726,
        "highlights": [
          "成本",
          "商品价格"
        ]
      },
      "elements": [
        {
          "type": "character",
          "name": "小布丁",
          "emotion": "serious",
          "enterFrom": "none",
          "position": null,
          "zIndex": 2,
          "duration": [
            16.311,
            27.926
          ]
        },
        {
          "type": "prop",
          "name": "超市货架",
          "emotion": null,
          "enterFrom": "right",
          "position": null,
          "zIndex": 3,
          "duration": [
            16.311,
            27.926
          ]
        }
      ]
    },
    {
      "sceneId": "S04",
      "start": 27.926,
      "end": 37.6,
      "backgroundName": "小镇街道",
      "subtitle": {
        "text": "更要命的是，工资总是慢半拍。企业要等行情稳了才舍得加薪。等你拿到加薪通知，物价早就又涨了一轮。",
        "start": 27.926,
        "end": 37.4,
        "highlights": [
          "加薪",
          "慢半拍"
        ]
      },
      "elements": [
        {
          "type": "character",
          "name": "小布丁",
          "emotion": "worried",
          "enterFrom": "none",
          "position": null,
          "zIndex": 2,
