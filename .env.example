# ============================================================
# 视频流水线环境配置模板
# 复制为 .env 并填入你的密钥（.env 不要提交到 git）
#   cp .env.example .env
# ============================================================

# ---- 1. 深度思考与设计模型 (Reasoning & Creative Design) ----
# 默认用于：情景剧剧本创作、创意梗与反转编排、分镜设计等思考任务
ANTHROPIC_API_KEY=
# 可选：自定义 Claude 模型名称（默认为 claude-3-opus-20240229，亦可指定 claude-3-7-sonnet-20250219）
CLAUDE_MODEL=claude-3-opus-20240229
# 可选：中转端点
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# 思考设计备选模型 (可选):
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# ---- 2. 日常批处理与极速执行模型 (Routine & Execution) ----
# 默认用于：语义一致性检查、数据格式清洗、发音校对、标签提取等
GEMINI_API_KEY=
# 可选：自定义 Gemini 模型名称（默认为 gemini-2.5-flash / gemini-3.7-flash）
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- 3. 语音合成（TTS）配置 --------------------------------
# Azure 语音合成（推荐）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
# 默认音色（可选）：zh-CN-YunxiNeural(云希男) / zh-CN-XiaoxiaoNeural(晓晓女)
# AZURE_VOICE=zh-CN-YunxiNeural
