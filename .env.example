# ============================================================
# 视频流水线环境配置模板
# 复制为 .env 并填入你的密钥（.env 不要提交到 git）
#   cp .env.example .env
# ============================================================

# ---- Azure 语音合成（推荐）--------------------------------
# 在 Azure 门户创建「语音服务」资源后获取：
#   https://portal.azure.com -> 语音服务 -> 密钥和终结点
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
# 默认音色（可选）：zh-CN-YunxiNeural(云希男) / zh-CN-XiaoxiaoNeural(晓晓女)
# AZURE_SPEECH_VOICE=zh-CN-YunxiNeural
